{
  "name": "uya",
  "version": "0.1.0",
  "description": "Local-first multi-agent AI workbench for macOS and Windows",
  "homepage": "https://github.com/akenoowww/uya",
  "repository": {
    "type": "git",
    "url": "https://github.com/akenoowww/uya.git"
  },
  "bugs": {
    "url": "https://github.com/akenoowww/uya/issues"
  },
  "license": "Apache-2.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "web:dev": "bun --filter @ide/web dev",
    "web:build": "bun --filter @ide/web build",
    "desktop:dev": "bun --filter @ide/desktop dev",
    "desktop:build": "bun --filter @ide/desktop build",
    "desktop:test": "bun --filter @ide/desktop test",
    "typecheck": "tsc --build",
    "test": "bun test",
    "core:smoke": "bun --no-env-file packages/core/smoke.ts",
    "core:loopback-smoke": "bun --no-env-file packages/core/loopback-smoke.ts",
    "check": "bun run typecheck && bun test && bun run core:smoke && bun run core:loopback-smoke && bun run web:build"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  }
}
